{
	"name": "@voila.dev/motion",
	"version": "6.0.134",
	"type": "module",
	"description": "Springs played by the browser, values on one frame loop, exits React waits for.",
	"license": "MIT",
	"homepage": "https://ui.voila.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/voila-voila-dev/platform.git",
		"directory": "packages/motion"
	},
	"keywords": [
		"animation",
		"spring",
		"web-animations",
		"motion",
		"react"
	],
	"publishConfig": {
		"access": "public",
		"exports": {
			".": "./dist/index.js",
			"./dom": "./dist/dom.js",
			"./react": "./dist/react/index.js"
		}
	},
	"files": [
		"src",
		"dist",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx"
	],
	"exports": {
		".": "./src/index.ts",
		"./dom": "./src/dom.ts",
		"./react": "./src/react/index.ts"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"build": "bun ../../scripts/ui/build-package.mjs",
		"check": "biome check",
		"check-types": "tsc --noEmit",
		"check-bundle": "bun scripts/check-bundle.mjs",
		"format": "biome format",
		"lint": "biome lint",
		"test": "vitest run && bun scripts/check-bundle.mjs",
		"postpack": "bun ../../scripts/publish-manifest/src/index.ts restore",
		"prepack": "bun run build && bun ../../scripts/publish-manifest/src/index.ts apply"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	},
	"devDependencies": {
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/browser-playwright": "5.0.0",
		"@voila.dev/typescript-config": "workspace:*",
		"esbuild": "^0.28.2",
		"jsdom": "30.0.1",
		"playwright": "^1.63.0",
		"react": "catalog:react",
		"react-dom": "catalog:react",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"sideEffects": false
}
