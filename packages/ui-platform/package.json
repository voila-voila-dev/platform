{
	"name": "@voila.dev/ui-platform",
	"version": "6.0.134",
	"type": "module",
	"description": "Business pages on @voila.dev/ui and @voila.dev/ui-landing, written for any product: a job posting first. Every word comes in through props.",
	"license": "MIT",
	"homepage": "https://ui.voila.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/voila-voila-dev/platform.git",
		"directory": "packages/ui-platform"
	},
	"keywords": [
		"react",
		"tailwindcss",
		"job-posting",
		"recruitment"
	],
	"publishConfig": {
		"access": "public",
		"exports": {
			"./package.json": "./package.json",
			"./job-posting": "./dist/job-posting/index.js",
			"./styles/*.css": "./dist/styles/*.css"
		}
	},
	"files": [
		"src",
		"dist",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx"
	],
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		"./package.json": "./package.json",
		"./job-posting": "./src/job-posting/index.ts",
		"./styles/*.css": "./src/styles/*.css"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"build": "bun ../../scripts/ui/build-package.mjs",
		"check": "biome check",
		"check-types": "tsc --noEmit",
		"format": "biome format",
		"lint": "biome lint",
		"postpack": "bun ../../scripts/publish-manifest/src/index.ts restore",
		"prepack": "bun run build && bun ../../scripts/publish-manifest/src/index.ts apply",
		"test": "vitest run"
	},
	"dependencies": {
		"@phosphor-icons/react": "catalog:react",
		"@voila.dev/ui": "workspace:*",
		"@voila.dev/ui-landing": "workspace:*"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tailwindcss": "^4.0.0"
	},
	"devDependencies": {
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@voila.dev/typescript-config": "workspace:*",
		"jsdom": "30.0.1",
		"react": "catalog:react",
		"react-dom": "catalog:react",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
