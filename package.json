{
	"name": "@voila.dev/platform",
	"version": "0.9.0",
	"description": "The technical bricks of a B2B platform on Effect, one subpath per brick: a small core at the root, then link tracking and the rest, each with its storage and HTTP adapters.",
	"license": "MIT",
	"author": "voila.dev",
	"type": "module",
	"sideEffects": false,
	"packageManager": "bun@1.4.3",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/voila-voila-dev/platform.git"
	},
	"exports": {
		".": "./src/index.ts",
		"./bulk-import": "./src/bulk-import/index.ts",
		"./bulk-import/csv": "./src/bulk-import/adapters/csv/index.ts",
		"./bulk-import/drizzle": "./src/bulk-import/adapters/drizzle/index.ts",
		"./bulk-import/json": "./src/bulk-import/adapters/json/index.ts",
		"./bulk-import/memory": "./src/bulk-import/adapters/memory/index.ts",
		"./bulk-import/xlsx": "./src/bulk-import/adapters/xlsx/index.ts",
		"./cache": "./src/cache/index.ts",
		"./cache/memory": "./src/cache/adapters/memory/index.ts",
		"./cache/redis": "./src/cache/adapters/redis/index.ts",
		"./bun": "./src/core/adapters/bun/index.ts",
		"./drizzle": "./src/core/adapters/drizzle/index.ts",
		"./file": "./src/file/index.ts",
		"./file/bun": "./src/file/adapters/bun/index.ts",
		"./file/http-server": "./src/file/adapters/http-server/index.ts",
		"./file/memory": "./src/file/adapters/memory/index.ts",
		"./http-server": "./src/core/adapters/http-server/index.ts",
		"./link-tracking": "./src/link-tracking/index.ts",
		"./link-tracking/click": "./src/link-tracking/click/index.ts",
		"./link-tracking/click/drizzle": "./src/link-tracking/click/adapters/drizzle/index.ts",
		"./link-tracking/click/http-server": "./src/link-tracking/click/adapters/http-server/index.ts",
		"./link-tracking/click/memory": "./src/link-tracking/click/adapters/memory/index.ts",
		"./link-tracking/link": "./src/link-tracking/link/index.ts",
		"./link-tracking/link/drizzle": "./src/link-tracking/link/adapters/drizzle/index.ts",
		"./link-tracking/link/http": "./src/link-tracking/link/http/index.ts",
		"./link-tracking/link/http-server": "./src/link-tracking/link/adapters/http-server/index.ts",
		"./link-tracking/link/memory": "./src/link-tracking/link/adapters/memory/index.ts",
		"./locale": "./src/locale/index.ts",
