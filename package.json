		"./location/here": "./src/location/adapters/here/index.ts",
		"./location/memory": "./src/location/adapters/memory/index.ts",
		"./memory": "./src/core/adapters/memory/index.ts",
		"./money": "./src/money/index.ts",
		"./rate-limiting": "./src/rate-limiting/index.ts",
		"./rate-limiting/memory": "./src/rate-limiting/adapters/memory/index.ts",
		"./rate-limiting/redis": "./src/rate-limiting/adapters/redis/index.ts",
		"./search": "./src/search/index.ts",
		"./search/drizzle": "./src/search/adapters/drizzle/index.ts",
		"./search/memory": "./src/search/adapters/memory/index.ts",
		"./search-engine": "./src/search-engine/index.ts",
		"./search-engine/dataforseo": "./src/search-engine/adapters/dataforseo/index.ts",
		"./search-engine/memory": "./src/search-engine/adapters/memory/index.ts",
		"./spreadsheet": "./src/spreadsheet/index.ts",
		"./spreadsheet/memory": "./src/spreadsheet/adapters/memory/index.ts",
		"./spreadsheet/xlsx": "./src/spreadsheet/adapters/xlsx/index.ts"
	},
	"imports": {
		"#*": "./src/*.ts"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test-helper.ts"
	],
	"publishConfig": {
		"access": "public",
		"exports": {
			".": "./dist/index.js",
			"./bulk-import": "./dist/bulk-import/index.js",
			"./bulk-import/csv": "./dist/bulk-import/adapters/csv/index.js",
			"./bulk-import/drizzle": "./dist/bulk-import/adapters/drizzle/index.js",
			"./bulk-import/json": "./dist/bulk-import/adapters/json/index.js",
			"./bulk-import/memory": "./dist/bulk-import/adapters/memory/index.js",
			"./bulk-import/xlsx": "./dist/bulk-import/adapters/xlsx/index.js",
			"./cache": "./dist/cache/index.js",
			"./cache/memory": "./dist/cache/adapters/memory/index.js",
			"./cache/redis": "./dist/cache/adapters/redis/index.js",
			"./bun": "./dist/core/adapters/bun/index.js",
			"./drizzle": "./dist/core/adapters/drizzle/index.js",
			"./file": "./dist/file/index.js",
			"./file/bun": "./dist/file/adapters/bun/index.js",
			"./file/http-server": "./dist/file/adapters/http-server/index.js",
			"./file/memory": "./dist/file/adapters/memory/index.js",
			"./http-server": "./dist/core/adapters/http-server/index.js",
			"./link-tracking": "./dist/link-tracking/index.js",
			"./link-tracking/click": "./dist/link-tracking/click/index.js",
			"./link-tracking/click/drizzle": "./dist/link-tracking/click/adapters/drizzle/index.js",
			"./link-tracking/click/http-server": "./dist/link-tracking/click/adapters/http-server/index.js",
			"./link-tracking/click/memory": "./dist/link-tracking/click/adapters/memory/index.js",
			"./link-tracking/link": "./dist/link-tracking/link/index.js",
			"./link-tracking/link/drizzle": "./dist/link-tracking/link/adapters/drizzle/index.js",
			"./link-tracking/link/http": "./dist/link-tracking/link/http/index.js",
			"./link-tracking/link/http-server": "./dist/link-tracking/link/adapters/http-server/index.js",
			"./link-tracking/link/memory": "./dist/link-tracking/link/adapters/memory/index.js",
			"./locale": "./dist/locale/index.js",
			"./location": "./dist/location/index.js",
			"./location/ban": "./dist/location/adapters/ban/index.js",
			"./location/here": "./dist/location/adapters/here/index.js",
			"./location/memory": "./dist/location/adapters/memory/index.js",
			"./memory": "./dist/core/adapters/memory/index.js",
			"./money": "./dist/money/index.js",
			"./rate-limiting": "./dist/rate-limiting/index.js",
			"./rate-limiting/memory": "./dist/rate-limiting/adapters/memory/index.js",
			"./rate-limiting/redis": "./dist/rate-limiting/adapters/redis/index.js",
			"./search": "./dist/search/index.js",
			"./search/drizzle": "./dist/search/adapters/drizzle/index.js",
			"./search/memory": "./dist/search/adapters/memory/index.js",
			"./search-engine": "./dist/search-engine/index.js",
			"./search-engine/dataforseo": "./dist/search-engine/adapters/dataforseo/index.js",
			"./search-engine/memory": "./dist/search-engine/adapters/memory/index.js",
			"./spreadsheet": "./dist/spreadsheet/index.js",
			"./spreadsheet/memory": "./dist/spreadsheet/adapters/memory/index.js",
			"./spreadsheet/xlsx": "./dist/spreadsheet/adapters/xlsx/index.js"
		},
		"imports": {
			"#*": "./dist/*.js"
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"changeset": "changeset",
		"check": "biome check",
		"check-types": "tsc --noEmit",
		"ci": "biome ci && tsc --noEmit && bun run test && bun run build",
		"format": "biome format --write",
		"lint": "biome lint --write",
		"postpack": "bun scripts/publish-manifest/src/index.ts restore",
		"prepack": "bun run build && bun scripts/publish-manifest/src/index.ts apply",
		"release": "changeset publish",
		"test": "bun test",
		"version-packages": "changeset version && biome format --write package.json"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "3.0.3",
		"@types/bun": "1.4.3",
		"drizzle-orm": "1.0.0-rc.5-5935859",
		"effect": "4.0.3",
		"exceljs": "^4.4.0",
		"typescript": "7.0.2"
	},
	"peerDependencies": {
		"drizzle-orm": "^1.0.0-rc.5-5935859",
		"effect": "^4.0.0",
		"exceljs": "^4.4.0"
	},
	"workspaces": [
		".",
		"scripts/*"
	],
	"peerDependenciesMeta": {
		"drizzle-orm": {
			"optional": true
		},
		"exceljs": {
			"optional": true
		}
	}
}
