{
	"name": "@voila.dev/platform-workspace",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.3",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/voila-voila-dev/platform.git"
	},
	"workspaces": [
		"packages/*",
		"scripts/*"
	],
	"scripts": {
		"build": "bun run --filter '@voila.dev/platform' build",
		"changeset": "changeset",
		"check": "biome check",
		"check-types": "tsc --noEmit && bun run --filter '*' check-types",
		"ci": "biome ci && bun run check-types && bun run test && bun run build",
		"format": "biome format --write",
		"lint": "biome lint --write",
		"release": "changeset publish",
		"test": "bun test",
		"version-packages": "changeset version && biome format --write packages/*/package.json"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "3.0.3",
		"@types/bun": "1.4.3",
		"typescript": "7.0.2"
	}
}
